        <section id="view-context" hidden>
          <p class="callout">
            These are dated, captured copies. Reading or editing a snapshot does
            not activate a skill or change an AI application's live memory.
          </p>
          <div class="toolbar">
            <label class="search"
              >Find a context file<input
                id="context-query"
                type="search"
                placeholder="Filter skills, memory, or instructions" /></label
            ><label
              >Type<select id="context-type">
                <option value="">All types</option>
                <option value="skills">Skills</option>
                <option value="memory">Memory</option>
                <option value="instructions">Instructions</option>
              </select></label
            >
          </div>
          <p id="context-summary" class="muted"></p>
          <div class="library-layout">
            <div id="context-list" class="chat-list"></div>
            <article id="context-reader" class="reader">
              <div class="empty">
                <h2>Inspect your context.</h2>
                <p>
                  Select a captured file. Original path and capture time are
                  shown alongside its contents.
                </p>
              </div>
            </article>
          </div>
        </section>
