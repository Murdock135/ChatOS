---
import SearchPanel from "./SearchPanel.astro";
---
        <section id="view-chats">
          <SearchPanel />
          <textarea id="chief-prompt" hidden readonly aria-label="Chief of Staff search request"></textarea>
          <p id="result-count" class="muted"></p>
          <div class="library-layout">
            <div>
              <div
                id="chat-list"
                class="chat-list"
                aria-label="Conversations"
              ></div>
              <button id="more" class="secondary" hidden>Load more</button>
            </div>
            <dialog id="reader" class="reader" aria-label="Conversation reader">
              <div class="empty">
                <span class="empty-symbol"
                  ><svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path
                      d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H8l-4 3v-6.5A7.5 7.5 0 0 1 11.5 4h1A7.5 7.5 0 0 1 20 11.5Z"
                    />
                    <path d="M8 10h8M8 14h5" /></svg
                ></span>
                <p class="eyebrow">YOUR CONVERSATION LIBRARY</p>
                <h2>Pick up where you left off.</h2>
                <p>
                  Find a past conversation, revisit a decision, or connect an idea. Select a chat to start reading.
                </p>
              </div>
            </dialog>
          </div>
        </section>
