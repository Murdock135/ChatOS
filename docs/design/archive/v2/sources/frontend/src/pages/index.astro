---
import WorkspaceLayout from "../layouts/WorkspaceLayout.astro";
import Home from "../components/Home.astro";
import Conversations from "../components/Conversations.astro";
import Map from "../components/Map.astro";
import Context from "../components/Context.astro";
import Health from "../components/Health.astro";
import Setup from "../components/Setup.astro";
import Settings from "../components/Settings.astro";
---
<WorkspaceLayout>
      <main>
        <header>
          <div>
            <p class="workspace-eyebrow">SMRITI <span aria-hidden="true">/</span> <span id="workspace-section">Home</span></p>
            <h1 id="page-title" hidden>Conversations</h1>
            <p id="subtitle" hidden></p>
          </div>
          <div class="header-actions">
            <button id="sync" class="sync-control"><span class="sync-dot" aria-hidden="true"></span><span id="sync-label">Sync</span></button>
          </div>
        </header>
        <p id="sync-status" class="sync-status" role="status" aria-live="polite" hidden><span class="sync-dot" aria-hidden="true"></span><span id="sync-message"></span></p>
        <div id="notice" role="status" aria-live="polite"></div>
        <Home />
        <Conversations />
        <Map />
        <Context />
        <Health />
        <Setup />
        <Settings />
        <footer>
          Captured conversations are historical records. A suggestion is not an
          accepted decision; a saved schedule is not proof that it ran.
        </footer>
      </main>

</WorkspaceLayout>
