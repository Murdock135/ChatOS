{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chat OS: sync",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "chatos",
        "sync"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Chat OS: status",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "chatos",
        "status"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Chat OS: tests",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Chat OS: doctor",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-m",
        "chatos",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    }
  ]
}
